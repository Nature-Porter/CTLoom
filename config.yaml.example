# Copy to .ctloom/config.local.yaml in your working project.
# Replace your-model-id with a model available from your provider.
# An empty api_key reads ANTHROPIC_API_KEY / OPENAI_API_KEY from the environment.
providers:
  - name: anthropic-official
    protocol: anthropic
    base_url: https://api.anthropic.com
    api_key: ""
    model: your-model-id
    thinking: false
    # Optional overrides; set values supported by your model:
    # context_window: 200000
    # max_output_tokens: 8192

  # OpenAI Responses API (OPENAI_API_KEY):
  # - name: openai-official
  #   protocol: openai
  #   base_url: https://api.openai.com/v1
  #   api_key: ""
  #   model: your-model-id

  # Chat Completions compatible service (OPENAI_API_KEY):
  # - name: compatible-provider
  #   protocol: openai-compat
  #   base_url: https://your-provider.example/v1
  #   api_key: ""
  #   model: your-model-id

permission_mode: default

# Optional MCP services. Leave empty for the first run.
mcp_servers: []

# To enable MCP, replace the empty list above with a list such as:
# mcp_servers:
#   - name: context7
#     command: npx
#     args: ["-y", "@upstash/context7-mcp"]
#
#   # Streamable HTTP (legacy SSE transport is not implemented):
#   - name: remote-tools
#     url: https://your-server.example/mcp
#     headers:
#       Authorization: "Bearer ${MCP_TOKEN}"
